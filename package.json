{
  "name": "operate",
  "private": true,
  "description": "Operate — touring operations PWA. React app (HashRouter) + vanilla persist/sync engine.",
  "type": "module",
  "scripts": {
    "check": "node scripts/check-syntax.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.engine.json --noEmit",
    "test": "node --experimental-strip-types --test",
    "build:engine": "tsc -p tsconfig.engine.json",
    "build:react": "vite build",
    "preview": "npm run build:react && npx --yes serve . -l 3000",
    "preview:4180": "npm run build:react && npx --yes serve . -l 4180",
    "ci": "npm run check && npm run typecheck && npm test && npm run build:engine && npm run build:react"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
